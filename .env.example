# CLASSORA API environment
# Copy this file to `.env` in the repository root and fill in values.
# Never commit `.env` or real keys.

# PostgreSQL via Supabase (leave blank to use the local JSON store in data/)
SUPABASE_URL=
SUPABASE_KEY=

# HMAC secret for signed session tokens (required in production)
SESSION_SECRET=replace-with-a-long-random-string

# Frontend origin allowed by CORS (local Vite, or the deployed Vercel URL)
APP_URL=http://localhost:5173
